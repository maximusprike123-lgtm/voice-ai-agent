# Copy to .env and fill in. Never commit .env.

# --- LLM: any OpenAI-compatible Chat Completions API ---
# Base URL up to and including the version prefix, e.g. https://api.example.com/v1
LLM_BASE_URL=
# Some self-hosted servers ignore the key; any non-empty value works for them.
LLM_API_KEY=
LLM_MODEL=
# Optional. Unset = field is omitted entirely (safe default for plain OpenAI-compatible
# backends). Set to "none" to disable thinking on a hybrid-reasoning model (e.g. Ollama +
# qwen3.5), or "low"/"medium"/"high" to enable it at that effort level.
LLM_REASONING_EFFORT=
# Local CPU inference (e.g. Ollama on a laptop) can be slow; raise this if requests time out.
LLM_TIMEOUT_SECONDS=60
# Optional JSON object merged into every request body, for backend-specific options that are
# not part of the standard API. OpenRouter provider routing, for example:
#   LLM_EXTRA_BODY={"provider": {"sort": "latency"}}
#   LLM_EXTRA_BODY={"provider": {"order": ["Fireworks"], "allow_fallbacks": false}}
# LLM_EXTRA_BODY=
# How long a phone call may wait on the LLM before the fallback phrase. First token: a stall
# is retried once, so the worst case is about twice this value. Later chunks: more slack.
LLM_FIRST_EVENT_TIMEOUT_SECONDS=4
LLM_EVENT_TIMEOUT_SECONDS=8
# Speech guard: blocks sentences that read out a phone number, claim "the request was accepted"
# when nothing was saved, say «записал» too early, or contain foreign-script characters.
# Leave it on; "false" is for debugging only.
SPEECH_GUARD=true

# --- Telegram notifications to the owner ---
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the owner (or of a group the bot is in)
TELEGRAM_CHAT_ID=

# --- App ---
# IANA time zone of the business; used for "today" in the prompt and working hours
TIMEZONE=Europe/Moscow
BUSINESS_CONFIG_PATH=config/business.yaml
DB_PATH=data/agent.db
LOG_LEVEL=INFO

# --- Speech (step 2, vendor not chosen yet) ---
# STT_PROVIDER=
# STT_API_KEY=
# TTS_PROVIDER=
# TTS_API_KEY=
# TTS_VOICE=

