# Copy to .env and fill in. Never commit .env.

# --- LLM: any OpenAI-compatible Chat Completions API ---
# Base URL up to and including the version prefix, e.g. https://api.example.com/v1
LLM_BASE_URL=
# Some self-hosted servers ignore the key; any non-empty value works for them.
LLM_API_KEY=
LLM_MODEL=
# Optional. Unset = field is omitted entirely (safe default for plain OpenAI-compatible
# backends). Set to "none" to disable thinking on a hybrid-reasoning model (e.g. Ollama +
# qwen3.5), or "low"/"medium"/"high" to enable it at that effort level.
LLM_REASONING_EFFORT=
# Local CPU inference (e.g. Ollama on a laptop) can be slow; raise this if requests time out.
LLM_TIMEOUT_SECONDS=60
# Optional JSON object merged into every request body, for backend-specific options that are
# not part of the standard API. OpenRouter provider routing, for example:
#   LLM_EXTRA_BODY={"provider": {"sort": "latency"}}
#   LLM_EXTRA_BODY={"provider": {"order": ["Fireworks"], "allow_fallbacks": false}}
# LLM_EXTRA_BODY=
# How long a phone call may wait on the LLM before the fallback phrase. First token: a stall
# is retried once, so the worst case is about twice this value. Later chunks: more slack.
LLM_FIRST_EVENT_TIMEOUT_SECONDS=4
LLM_EVENT_TIMEOUT_SECONDS=8
# Speech guard: blocks sentences that read out a phone number, claim "the request was accepted"
# when nothing was saved, say «записал» too early, or contain foreign-script characters.
# Leave it on; "false" is for debugging only.
SPEECH_GUARD=true

# --- Telegram notifications to the owner ---
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the owner (or of a group the bot is in)
TELEGRAM_CHAT_ID=

# --- App ---
# IANA time zone of the business; used for "today" in the prompt and working hours
TIMEZONE=Europe/Moscow
BUSINESS_CONFIG_PATH=config/business.yaml
DB_PATH=data/agent.db
LOG_LEVEL=INFO

# --- Agent voice ---
# "male" or "female": the TTS voice and how the model speaks about itself (я понял / я поняла)
AGENT_GENDER=male

# --- Speech output (TTS) ---
# Primary and fallback. The primary is tried first; if it fails, gives no audio within
# TTS_FIRST_CHUNK_TIMEOUT_SECONDS, or is not configured, the fallback speaks that sentence, and the
# primary sits out TTS_PRIMARY_PAUSE_SECONDS. TTS_FALLBACK_PROVIDER=none turns the fallback off.
TTS_PROVIDER=elevenlabs
TTS_FALLBACK_PROVIDER=silero
TTS_FIRST_CHUNK_TIMEOUT_SECONDS=1.5
TTS_PRIMARY_PAUSE_SECONDS=60
# ElevenLabs. Without a key it reports "key: not set" and the fallback speaks. NOTE: ElevenLabs
# blocks Russia by its own terms; a regional or proxy endpoint can go in ELEVENLABS_BASE_URL.
# List voices with: .venv/bin/python scripts/check_tts.py voices --search russian
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Silero (local, needs torch). v5_ru voices: aidar, baya, kseniya, xenia, eugene (listen to the samples:
# scripts/check_tts.py samples). Standard models are CC BY-NC: internal tests only.
SILERO_MODEL=v5_ru
# SILERO_CACHE_DIR=data/silero
SILERO_SPEAKER_MALE=aidar
SILERO_SPEAKER_FEMALE=xenia

# --- Speech input (STT), step 2.1.e ---
# STT_PROVIDER=

# --- Telephony (step 3, rendered into Asterisk config only) ---
# SIP_PROVIDER_HOST=
# SIP_USERNAME=
# SIP_PASSWORD=
# AUDIOSOCKET_PORT=9092
